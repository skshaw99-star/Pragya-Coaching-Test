<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>बायोलॉजी इंटरैक्टिव टेस्ट</title>
    <style>
        body { font-family: sans-serif; background-color: #f4f7f6; padding: 20px; color: #333; }
        .container { max-width: 600px; margin: auto; background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h1 { text-align: center; color: #2C3E50; border-bottom: 2px solid #27AE60; padding-bottom: 10px; }
        .question { margin-bottom: 20px; font-weight: bold; }
        .options { list-style: none; padding: 0; }
        .options li { margin-bottom: 10px; }
        .options label { display: block; padding: 12px; background: #EBF5FB; border-radius: 8px; cursor: pointer; transition: background 0.3s; }
        .options label:hover { background: #D6EAF8; }
        .options input { display: none; }
        input:checked + label { background: #27AE60; color: #fff; font-weight: bold; }
        #submit-btn { width: 100%; padding: 15px; background: #2C3E50; color: #fff; border: none; border-radius: 8px; font-size: 18px; cursor: pointer; }
        #result { margin-top: 20px; font-size: 18px; font-weight: bold; text-align: center; color: #2C3E50; }
    </style>
</head>
<body>
    <div class="container">
        <h1>बायोलॉजी टेस्ट</h1>
        <form id="quiz-form">
            <div class="question">1. मानव शरीर की सबसे बड़ी ग्रंथि कौन सी है?</div>
            <ul class="options">
                <li>
                    <input type="radio" name="q1" id="q1a" value="यकृत">
                    <label for="q1a">यकृत</label>
                </li>
                <li>
                    <input type="radio" name="q1" id="q1b" value="अग्न्याशय">
                    <label for="q1b">अग्न्याशय</label>
                </li>
            </ul>

            <div class="question">2. प्रकाश संश्लेषण किस रंग में सबसे कम होता है?</div>
            <ul class="options">
                <li>
                    <input type="radio" name="q2" id="q2a" value="नीले रंग">
                    <label for="q2a">नीले रंग</label>
                </li>
                <li>
                    <input type="radio" name="q2" id="q2b" value="हरे रंग">
                    <label for="q2b">हरे रंग</label>
                </li>
            </ul>

            <div class="question">3. कोशिका का ऊर्जा घर किसे कहते हैं?</div>
            <ul class="options">
                <li>
                    <input type="radio" name="q3" id="q3a" value="माइटोकॉन्ड्रिया">
                    <label for="q3a">माइटोकॉन्ड्रिया</label>
                </li>
                <li>
                    <input type="radio" name="q3" id="q3b" value="राइबोसोम">
                    <label for="q3b">राइबोसोम</label>
                </li>
            </ul>

            <div class="question">4. जीवन की मूलभूत इकाई क्या है?</div>
            <ul class="options">
                <li>
                    <input type="radio" name="q4" id="q4a" value="कोशिका">
                    <label for="q4a">कोशिका</label>
                </li>
                <li>
                    <input type="radio" name="q4" id="q4b" value="ऊतक">
                    <label for="q4b">ऊतक</label>
                </li>
            </ul>

            <div class="question">5. रक्त का लाल रंग किसके कारण होता है?</div>
            <ul class="options">
                <li>
                    <input type="radio" name="q5" id="q5a" value="प्लाज्मा">
                    <label for="q5a">प्लाज्मा</label>
                </li>
                <li>
                    <input type="radio" name="q5" id="q5b" value="हीमोग्लोबिन">
                    <label for="q5b">हीमोग्लोबिन</label>
                </li>
            </ul>

            <button type="button" id="submit-btn" onclick="calculateResult()">सबमिट करें</button>
        </form>
        <div id="result"></div>
    </div>

    <script>
        function calculateResult() {
            let score = 0;
            const answers = { q1: "यकृत", q2: "हरे रंग", q3: "माइटोकॉन्ड्रिया", q4: "कोशिका", q5: "हीमोग्लोबिन" };
            const form = document.getElementById("quiz-form");
            for (let question in answers) {
                const selected = form.querySelector(`input[name="${question}"]:checked`);
                if (selected && selected.value === answers[question]) {
                    score++;
                }
            }
            document.getElementById("result").innerHTML = `आपका स्कोर है: ${score} / 5`;
        }
    </script>
</body>
</html>
